# Copy this file to .env.local. Do not commit .env.local.
# The service-role key bypasses Row Level Security. It is read only by the
# server enquiry route. Never put it in a NEXT_PUBLIC_ variable or in browser code.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public client key. Use the legacy anon key, or the dashboard publishable key
# (often beginning with sb_publishable_). This key is safe to expose to the browser.
# The application reads this value first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias. If the Supabase dashboard shows a publishable key instead of an
# anon key, put it here and leave NEXT_PUBLIC_SUPABASE_ANON_KEY empty.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required before the contact form can store an enquiry.
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Sends the enquiry notification. The current key may only send mail.
RESEND_API_KEY=

# Sender on a domain you have verified in Resend. Do not use a Gmail address.
# Example: Machavolu Ramesh Sarma <enquiries@your-verified-domain>
RESEND_FROM_EMAIL=
