# Copy this file to .env.local. Do not commit .env.local.
# Never put the Supabase service-role key in any variable here.
# The service-role key bypasses Row Level Security and must not be used by this website.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public client key. Use the legacy anon key, or the dashboard publishable key
# (often beginning with sb_publishable_). This key is safe to expose to the browser.
# The application reads this value first.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias. If the Supabase dashboard shows a publishable key instead of an
# anon key, put it here and leave NEXT_PUBLIC_SUPABASE_ANON_KEY empty.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
